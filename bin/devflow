#!/usr/bin/env node
// 统一 CLI 入口：把常见操作收敛到 `devflow <command>`，参数原样透传给插件脚本。
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { COMMANDS } from '../scripts/lib/cli-commands.mjs';

const HELP = `devflow CLI

用法：
  devflow <command> [options]

命令：
${Object.entries(COMMANDS).map(([name, [, desc]]) => `  ${name.padEnd(9)} ${desc}`).join('\n')}
  help       显示本帮助

示例：
  devflow init
  devflow gen
  devflow doctor --json
  devflow route --stage plan
  devflow route --detect
  devflow sync --dry-run
  devflow upstream --stage review
  devflow upstream --stage review --apply
  devflow upstream --stack java-spring
  devflow upstream --stack java-spring --to personal --apply
  devflow upstream --shared --to upstream --pr --apply
  devflow upstream --revert 20261102120000-1234
  devflow ship --stage review --dry-run
  devflow ship --stack java-spring --dry-run
  devflow triage --slug add-login --write
  devflow triage --slug fix-auth --focus security --agents 2
  devflow triage --slug add-login --check
  devflow triage --slug add-login --since v1.2.0
  devflow triage --escalate
  devflow check --stage req --slug add-login
  devflow check --stage debug --json
  devflow trace --slug add-login
  devflow trace --slug add-login --check
  devflow trace --slug add-login --json
  devflow test --gaps
  devflow test --changed
  devflow test --command "npm test" --exit-code 0 --duration-ms 1200

所有参数原样传给对应脚本；也可继续使用 node scripts/devflow-*.mjs。`;

async function main() {
  const [command, ...rest] = process.argv.slice(2);
  if (!command || command === 'help' || command === '--help' || command === '-h') {
    console.log(HELP);
    return;
  }
  const entry = COMMANDS[command];
  if (!entry) {
    console.error(`[ERR] 未知命令：${command}`);
    console.log(HELP);
    process.exitCode = 1;
    return;
  }
  // 子命令后的 --help 必须在这里拦下：各脚本未统一实现该参数，
  // 直接透传可能被当成普通参数执行（例如 test --help 被记录成一次通过）。
  if (rest.includes('--help') || rest.includes('-h')) {
    console.log(`devflow ${command} — ${entry[1]}`);
    console.log('');
    console.log(`用法：devflow ${command} [options]`);
    console.log('参数说明见 docs/usage.md。');
    return;
  }
  const pluginRoot = dirname(dirname(fileURLToPath(import.meta.url)));
  const mod = await import(pathToFileURL(join(pluginRoot, 'scripts', entry[0])).href);
  await mod.main(rest);
}

main().catch((err) => {
  console.error(`[ERR] ${err.message}`);
  process.exit(1);
});
