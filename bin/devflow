#!/usr/bin/env node
// 统一 CLI 入口：把常见操作收敛到 `devflow <command>`，参数原样透传给插件脚本。
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { COMMANDS } from '../scripts/lib/cli-commands.mjs';
import { isCommand, renderCommandHelp, renderHelp } from '../scripts/lib/cli-help.mjs';

async function main() {
  const [command, ...rest] = process.argv.slice(2);
  if (!command || command === 'help' || command === '--help' || command === '-h') {
    // `devflow help <命令>` 与 `devflow --help <命令>` 都显示单命令用法；
    // 目标位置再出现 help 标志时按“无目标”处理，避免把标志当成命令名。
    const target = rest[0] && !['--help', '-h'].includes(rest[0]) ? rest[0] : null;
    if (rest.length > 1) {
      console.error('[ERR] 一次只能查看一个命令：devflow help <命令>');
      process.exitCode = 1;
      return;
    }
    if (target) {
      // 只接受命令名；拒绝路径、空格与 shell 元字符，也不回显原始输入。
      if (!/^[a-z][a-z0-9-]*$/.test(target)) {
        console.error('[ERR] 只接受一个命令名，例如：devflow help change');
        process.exitCode = 1;
        return;
      }
      if (!isCommand(target) && target !== 'help') {
        console.error(`[ERR] 未知命令：${target}`);
        console.log(renderHelp());
        process.exitCode = 1;
        return;
      }
      console.log(renderCommandHelp(target));
      return;
    }
    console.log(renderHelp());
    return;
  }
  const entry = COMMANDS[command];
  if (!entry) {
    console.error(`[ERR] 未知命令：${command}`);
    console.log(renderHelp());
    process.exitCode = 1;
    return;
  }
  // 子命令后的 --help 必须在这里拦下：各脚本未统一实现该参数，
  // 直接透传可能被当成普通参数执行（例如 test --help 被记录成一次通过）。
  if (rest.includes('--help') || rest.includes('-h')) {
    console.log(renderCommandHelp(command));
    return;
  }
  const pluginRoot = dirname(dirname(fileURLToPath(import.meta.url)));
  const mod = await import(pathToFileURL(join(pluginRoot, 'scripts', entry[0])).href);
  await mod.main(rest);
}

main().catch((err) => {
  console.error(`[ERR] ${err.message}`);
  process.exit(1);
});
